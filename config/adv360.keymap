#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        vim_command: vim_command {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp COLON>;
            label = "VIM_COMMAND";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp GRAVE       &kp N1    &kp N2     &kp N3   &kp N4        &kp N5  &mo 2                                                       &mo 3      &kp N6  &kp N7          &kp N8          &kp N9           &kp N0     &kp AT
&kp TAB         &kp Q     &kp W      &kp E    &kp R         &kp T   &kp FSLH                                                    &kp EQUAL  &kp Y   &kp U           &kp I           &kp O            &kp P      &kp SINGLE_QUOTE
&kp ESCAPE      &kp A     &kp S      &kp D    &kp F         &kp G   &kp BSLH  &kp LCTRL  &kp LEFT_WIN      &kp LGUI  &kp RCTRL  &kp MINUS  &kp H   &kp J           &kp K           &kp L            &kp SEMI   &kp DOUBLE_QUOTES
&mt LSHFT CAPS  &kp Z     &kp X      &kp C    &kp V         &kp B                        &kp LEFT_ALT      &kp LALT                        &kp N   &kp M           &kp UP_ARROW    &kp DOT          &kp COMMA  &kp GRAVE
&kp LCTRL       &kp LGUI  &kp COMMA  &kp DOT  &vim_command          &kp BSPC  &kp DEL    &tog 1            &tog 4    &kp ENTER  &kp SPACE          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LBKT   &kp RBKT
            >;
        };

        navigation {
            display-name = "Nav";
            bindings = <
&kp GRAVE       &kp N1     &kp N2     &kp N3    &kp N4        &kp N5    &mo 2                                                   &mo 3      &kp N6  &kp N7          &kp N8          &kp N9           &kp N0     &kp AT
&kp TAB         &kp EQUAL  &kp SEMI   &kp SQT   &kp LPAR      &kp RPAR  &kp FSLH                                                &kp EQUAL  &kp Y   &kp INSERT      &kp HOME        &kp PG_UP        &kp P      &kp SINGLE_QUOTE
&kp ESC         &kp MINUS  &kp COMMA  &kp DOT   &kp LBRC      &kp RBRC  &kp BSLH  &kp LCTRL  &kp LGUI      &kp LGUI  &kp RCTRL  &kp MINUS  &kp H   &kp DELETE      &kp END         &kp PG_DN        &kp SEMI   &kp DOUBLE_QUOTES
&mt LSHFT CAPS  &kp Z      &kp BSLH   &kp FSLH  &kp LBKT      &kp RBKT                       &kp LALT      &kp LALT                        &kp N   &kp M           &kp UP_ARROW    &kp DOT          &kp COMMA  &kp GRAVE
&kp LCTRL       &kp LGUI   &kp COMMA  &kp DOT   &vim_command            &kp BSPC  &kp DEL    &trans        &none     &kp ENTER  &kp SPACE          &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp LBKT   &kp RBKT
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans                                         &none      &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                         &trans     &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp PSCRN  &trans  &trans      &trans  &trans  &kp PSCRN  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans      &trans                     &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans     &trans  &none       &none   &trans  &trans             &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp GRAVE       &kp N1    &kp N2     &kp N3   &kp N4        &kp N5  &mo 2                                                       &mo 3            &kp N6  &kp KP_NUM  &kp KP_EQUAL  &kp KP_SLASH  &kp KP_MULTIPLY  &kp AT
&kp TAB         &kp Q     &kp W      &kp E    &kp R         &kp T   &kp FSLH                                                    &kp EQUAL        &kp Y   &kp KP_N7   &kp KP_N8     &kp KP_N9     &kp KP_MINUS     &kp SINGLE_QUOTE
&kp ESC         &kp A     &kp S      &kp D    &kp F         &kp G   &kp BSLH  &kp LCTRL  &kp LEFT_WIN      &kp LGUI  &kp RCTRL  &kp MINUS        &kp H   &kp KP_N4   &kp KP_N5     &kp KP_N6     &kp KP_PLUS      &kp DOUBLE_QUOTES
&mt LSHFT CAPS  &kp Z     &kp X      &kp C    &kp V         &kp B                        &kp LEFT_ALT      &kp LALT                              &kp N   &kp KP_N1   &kp KP_N2     &kp KP_N3     &kp KP_ENTER     &kp GRAVE
&kp LCTRL       &kp LGUI  &kp COMMA  &kp DOT  &vim_command          &kp BSPC  &kp DEL    &none             &trans    &kp ENTER  &kp KP_NUMBER_0          &kp KP_N0   &kp ESC       &kp KP_DOT    &kp LBKT         &kp RBKT
            >;
        };
    };
};
